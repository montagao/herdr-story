# Copy to .env and fill in. .env is git-ignored; .env.example (this file) is not, so no real
# key belongs here. Bun loads .env from the directory the bridge is started in, so it must sit
# in the project root and the bridge must be run from the project root.

# A restricted key (rk_…), not the account secret key. It needs Read on Balance transactions
# and Read on Events, and no write permission anywhere.
# STRIPE_RESTRICTED_KEY=rk_live_replace_me

# Optional.
# HERDR_STORY_PROJECTS_DIR=/absolute/path/to/projects # free-agent terminal's starting directory
# HERDR_STORY_REVENUE_DAYS=30       # window for the funds figure
# HERDR_STORY_STRIPE_POLL_MS=15000  # how often Stripe's event feed is read

# RevenueCat, if you bill through the app stores. A v2 secret key with
# charts_metrics:overview:read (and project_configuration:projects:read, unless you set the
# project id below). Works alongside Stripe — the two totals are added when the currency matches.
# REVENUECAT_API_KEY=sk_replace_me
# REVENUECAT_PROJECT_ID=proj_...

# Optional fixed start dates for each provider’s All time total (UTC, YYYY-MM-DD).
# HERDR_STORY_STRIPE_START_DATE=2023-06-01
# HERDR_STORY_REVENUECAT_START_DATE=2026-06-05

# Optional real-time RevenueCat notifications. Only proxy this dedicated listener publicly,
# never the main game/terminal bridge. Setup script creates a random authorization header.
# HERDR_STORY_WEBHOOK_PORT=7789
# REVENUECAT_WEBHOOK_PUBLIC_URL=https://your-public-host/webhooks/revenuecat
# REVENUECAT_WEBHOOK_AUTH="Bearer replace_with_a_long_random_secret"
# Optional HMAC verification: use the integration signing secret from RevenueCat.
# If both secrets are set, both authorization and signature must pass.
# REVENUECAT_WEBHOOK_SIGNING_SECRET=replace_with_signing_secret
# REVENUECAT_WEBHOOK_INTEGRATION_ID=whintgr_...

# Bridge defaults to loopback. Read-only mode still exposes private terminal output.
# HERDR_STORY_WRITE=0
# HERDR_SOCKET_PATH=/absolute/path/to/herdr.sock
# HERDR_STORY_STATE_DIR=/absolute/path/to/private/state
# Explicit trusted browser origins for a private reverse proxy (no wildcard or trailing slash).
# npm run dev:tailscale sets the current Tailscale origin automatically.
# HERDR_STORY_ALLOWED_ORIGINS=https://office.example.test
